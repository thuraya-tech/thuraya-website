---
/** Trace product mark — waterfall span diagram. */
export interface Props { size?: number; class?: string; }
const { size = 160, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 180 140" xmlns="http://www.w3.org/2000/svg"
     width={size} height={Math.round(size * 140/180)} class={cls} aria-hidden="true">
  <g stroke="#0A1124" stroke-width="0.4" opacity="0.1">
    <line x1="20" y1="6" x2="20" y2="134"/>
    <line x1="60" y1="6" x2="60" y2="134"/>
    <line x1="100" y1="6" x2="100" y2="134"/>
    <line x1="140" y1="6" x2="140" y2="134"/>
    <line x1="170" y1="6" x2="170" y2="134"/>
  </g>
  <circle cx="20"  cy="18"  r="3.4" fill="#0A1124"/><rect x="22"  y="14.5" width="142" height="7" fill="#0A1124" opacity="0.85"/>
  <circle cx="36"  cy="34"  r="2.2" fill="#0A1124"/><rect x="38"  y="30.5" width="98"  height="7" fill="#0A1124" opacity="0.7"/>
  <circle cx="52"  cy="50"  r="2.6" fill="#0A1124"/><rect x="54"  y="46.5" width="52"  height="7" fill="#0A1124" opacity="0.6"/>
  <circle cx="66"  cy="66"  r="2.4" fill="#B8862E"/><rect x="68"  y="62.5" width="36"  height="7" fill="#B8862E"/>
  <circle cx="52"  cy="82"  r="2.0" fill="#0A1124"/><rect x="54"  y="78.5" width="64"  height="7" fill="#0A1124" opacity="0.55"/>
  <circle cx="36"  cy="98"  r="2.2" fill="#0A1124"/><rect x="38"  y="94.5" width="86"  height="7" fill="#0A1124" opacity="0.5"/>
  <circle cx="22"  cy="114" r="2.0" fill="#0A1124"/><rect x="24"  y="110.5" width="120" height="7" fill="#0A1124" opacity="0.45"/>
</svg>
