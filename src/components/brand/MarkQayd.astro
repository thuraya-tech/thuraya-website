---
/** Qayd product mark — registry / ledger diagram. */
export interface Props { size?: number; class?: string; }
const { size = 160, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 180 140" xmlns="http://www.w3.org/2000/svg"
     width={size} height={Math.round(size * 140/180)} class={cls} aria-hidden="true">
  <g fill="none" stroke="#B8862E" stroke-width="1.1" stroke-linejoin="round">
    <path d="M44 26 C44 18 50 14 60 14 L150 14 C160 14 166 20 166 30 L166 110 C166 120 160 126 150 126 L60 126 C50 126 44 122 44 114 Z"/>
  </g>
  <g fill="none" stroke="#0A1124" stroke-width="0.5" opacity="0.35">
    <path d="M50 30 C50 24 54 22 60 22 L150 22 C156 22 160 26 160 32 L160 108 C160 114 156 118 150 118 L60 118 C54 118 50 116 50 110 Z"/>
  </g>
  <line x1="32" y1="34" x2="32" y2="106" stroke="#B8862E" stroke-width="2.1" stroke-linecap="round"/>
  <line x1="36" y1="34" x2="36" y2="106" stroke="#B8862E" stroke-width="0.7" opacity="0.7"/>
  <circle cx="34" cy="30"  r="3.4" fill="none" stroke="#B8862E" stroke-width="1.1"/>
  <circle cx="34" cy="110" r="3.4" fill="none" stroke="#B8862E" stroke-width="1.1"/>
  <g transform="translate(34 70) rotate(45)">
    <rect x="-4" y="-4" width="8" height="8" fill="#B8862E"/>
    <rect x="-2.4" y="-2.4" width="4.8" height="4.8" fill="#0A1124"/>
  </g>
  <text x="56" y="40" font-family="JetBrains Mono, monospace" font-size="6.6" fill="#B8862E" letter-spacing="1.2">REG · ٢٠٢٦</text>
  <g stroke="#0A1124" stroke-width="0.7" opacity="0.55">
    <line x1="58" y1="58" x2="92" y2="58"/>
    <line x1="58" y1="68" x2="96" y2="68"/>
    <line x1="58" y1="78" x2="88" y2="78"/>
    <line x1="58" y1="88" x2="94" y2="88"/>
    <line x1="58" y1="98" x2="90" y2="98"/>
  </g>
  <line x1="106" y1="52" x2="106" y2="104" stroke="#0A1124" stroke-width="0.6" opacity="0.35"/>
  <g fill="#0A1124">
    <circle cx="134" cy="58" r="2.4"/><circle cx="148" cy="60" r="1.6"/>
    <circle cx="120" cy="68" r="2.0"/><circle cx="140" cy="76" r="3.0"/>
    <circle cx="154" cy="80" r="1.7"/><circle cx="128" cy="88" r="2.2"/>
    <circle cx="146" cy="98" r="1.9"/>
  </g>
</svg>
